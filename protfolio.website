<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Your Name | Portfolio</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <header>
    <div class="container">
      <h1>Your Name</h1>
      <nav>
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
        <a href="assets/resume.pdf" download>Resume</a>
      </nav>
    </div>
  </header>

  <section id="about">
    <div class="container">
      <img src="assets/profile.jpg" alt="Your Photo" class="profile-pic" />
      <h2>About Me</h2>
      <p>
        I am a passionate developer with interests in web development, UI design, and software engineering.
      </p>
    </div>
  </section>

  <section id="projects">
    <div class="container">
      <h2>My Projects</h2>
      <div class="project">
        <h3>To-Do App</h3>
        <p>A basic to-do list web app using HTML, CSS, and JavaScript.</p>
        <a href="https://github.com/yourusername/todo-app" target="_blank">View on GitHub</a>
      </div>

      <div class="project">
        <h3>Weather App</h3>
        <p>Displays weather using OpenWeather API. Built with JavaScript.</p>
        <a href="https://github.com/yourusername/weather-app" target="_blank">View on GitHub</a>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="container">
      <h2>Contact Me</h2>
      <form action="mailto:your-email@example.com" method="POST" enctype="text/plain">
        <input type="text" name="name" placeholder="Your Name" required />
        <input type="email" name="email" placeholder="Your Email" required />
        <textarea name="message" placeholder="Your Message" rows="5"></textarea>
        <button type="submit">Send Message</button>
      </form>
    </div>
  </section>

  <footer>
    <div class="container">
      <p>&copy; 2025 Your Name | All Rights Reserved.</p>
    </div>
  </footer>

  <script src="script.js"></script>
</body>
</html>
/* Reset & Base Styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
body {
  font-family: 'Segoe UI', sans-serif;
  line-height: 1.6;
  color: #333;
  background-color: #f8f8f8;
}
.container {
  width: 90%;
  max-width: 1000px;
  margin: auto;
}

/* Header */
header {
  background-color: #2c3e50;
  color: white;
  padding: 1rem 0;
}
header h1 {
  text-align: center;
}
nav {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-top: 0.5rem;
}
nav a {
  color: white;
  text-decoration: none;
  font-weight: bold;
}
nav a:hover {
  text-decoration: underline;
}

/* About Section */
#about {
  background: #ecf0f1;
  padding: 2rem 0;
  text-align: center;
}
.profile-pic {
  width: 150px;
  border-radius: 50%;
  margin-bottom: 1rem;
}

/* Projects */
#projects {
  padding: 2rem 0;
}
.project {
  background: white;
  padding: 1rem;
  margin-bottom: 1rem;
  border-left: 5px solid #2980b9;
}
.project h3 {
  margin-bottom: 0.5rem;
}
.project a {
  color: #2980b9;
  text-decoration: none;
}
.project a:hover {
  text-decoration: underline;
}

/* Contact */
#contact {
  background: #ecf0f1;
  padding: 2rem 0;
}
form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  max-width: 500px;
  margin: auto;
}
form input, form textarea {
  padding: 10px;
  font-size: 1rem;
}
form button {
  padding: 10px;
  background: #2c3e50;
  color: white;
  border: none;
  cursor: pointer;
}
form button:hover {
  background: #34495e;
}

/* Footer */
footer {
  background: #2c3e50;
  color: white;
  text-align: center;
  padding: 1rem 0;
}

/* Responsive */
@media (max-width: 600px) {
  nav {
    flex-direction: column;
  }
}
// You can add interactivity here (like dark mode toggle or animations)
